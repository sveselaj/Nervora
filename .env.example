# ---------------------------------------------------------------------------
# Secure MCP Gateway — environment configuration
# Copy to .env for local development. NEVER commit a real .env.
# ---------------------------------------------------------------------------

# --- Runtime mode ---------------------------------------------------------
# demo  -> destructive tools are denied/dry-run only, dev token signing enabled
# prod  -> Entra ID OIDC validation, destructive tools gated by approval token
APP_ENV=demo

# --- Database -------------------------------------------------------------
# Local docker compose Postgres. Tests default to in-memory SQLite.
DATABASE_URL=postgresql+psycopg://smg:smg@postgres:5432/smg

# --- Auth -----------------------------------------------------------------
# DEV ONLY: symmetric secret used to sign/verify local test tokens (HS256).
# In production this is unused; tokens are validated against Entra ID JWKS.
DEV_TOKEN_SIGNING_SECRET=dev-only-not-for-production-change-me
AUTH_MODE=dev            # dev | entra

# Production Entra ID / OIDC settings (used when AUTH_MODE=entra)
ENTRA_TENANT_ID=
ENTRA_AUDIENCE=api://secure-mcp-gateway
ENTRA_ISSUER=
ENTRA_JWKS_URL=

# --- Async queue (Service Bus abstraction) --------------------------------
# local -> Postgres-backed queue table (works offline, used by docker compose)
# azure -> Azure Service Bus (set SERVICEBUS_CONNECTION_STRING)
QUEUE_BACKEND=local
SERVICEBUS_CONNECTION_STRING=
SERVICEBUS_QUEUE_NAME=tool-jobs
QUEUE_MAX_DELIVERY_COUNT=5

# --- Databricks -----------------------------------------------------------
# mock -> deterministic in-process mock (default for the reference demo)
# real -> requires DATABRICKS_HOST + DATABRICKS_TOKEN + warehouse/job ids
DATABRICKS_MODE=mock
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_WAREHOUSE_ID=

# --- Observability --------------------------------------------------------
OTEL_ENABLED=true
OTEL_SERVICE_NAME=mcp-gateway
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_CONSOLE_FALLBACK=true   # print spans to stdout when no collector reachable

# --- Approvals (destructive write gate) -----------------------------------
# In demo mode execute_crm_update is hard-disabled regardless of this token.
ADMIN_APPROVAL_TOKEN=
